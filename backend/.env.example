# Optional: GitHub Personal Access Token (classic) with `public_repo` or full `repo` scope.
# Improves rate limits for contribution analytics (60 req/hr unauthenticated → 5000+ with token).
GITHUB_TOKEN=

# How many branch tips to scan per repo for commits (default 20). Higher = more API calls.
# GITHUB_MAX_BRANCHES_PER_REPO=20
# GITHUB_MAX_PAGES_PER_BRANCH=4
